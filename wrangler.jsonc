{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sto",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sto-db",
      // Zamijeni ID-om koji dobiješ od: npx wrangler d1 create sto-db
      "database_id":"97d38eaf-4875-4488-b2d3-ed2664e621e9", 
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "RL", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_AUTH", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  // Slanje obavještenja pokreće vanjski cron koji svake minute otvara /api/push/tick (vidi README).
  // Ako nalog ima slobodan Cloudflare cron, može se dodati: "triggers": { "crons": ["* * * * *"] }
  // Tajne: VAPID_PUBLIC, VAPID_PRIVATE, VAPID_SUBJECT, PUSH_TICK_KEY. Opciono: PUSH_BATCH (podrazumijevano 40), REMIND_HOUR (podrazumijevano 10).
  "observability": { "enabled": true }
}
